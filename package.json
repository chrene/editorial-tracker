{
  "name": "editorial-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --build",
    "docker:rebuild": "docker compose up -d --build backend frontend",
    "docker:setup": "docker compose exec backend pnpm db:push && docker compose exec backend pnpm db:seed",
    "docker:start": "pnpm docker:up && pnpm docker:setup",
    "docker:db": "docker compose up -d db",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
