generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  editor
  contributor

  @@map("role")
}

enum ContentType {
  article
  video

  @@map("content_type")
}

enum ContentStatus {
  idea
  draft
  review
  published
  archived

  @@map("content_status")
}

enum AuditAction {
  created
  updated
  status_changed
  published
  archived
  deleted

  @@map("audit_action")
}

model User {
  id    String @id @db.Uuid
  name  String
  email String @unique
  role  Role

  created   ContentItem[] @relation("createdBy")
  updated   ContentItem[] @relation("updatedBy")
  published ContentItem[] @relation("publishedBy")
  archived  ContentItem[] @relation("archivedBy")
  auditLog  AuditLog[]

  @@map("users")
}

model ContentItem {
  id     String        @id @default(uuid()) @db.Uuid
  title  String
  type   ContentType
  status ContentStatus @default(idea)

  authorIds String[] @default([]) @map("author_ids") @db.Uuid

  deadline DateTime? @db.Timestamptz(3)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  publishedBy String?   @map("published_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  archivedBy  String?   @map("archived_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  creator   User  @relation("createdBy", fields: [createdBy], references: [id])
  updater   User  @relation("updatedBy", fields: [updatedBy], references: [id])
  publisher User? @relation("publishedBy", fields: [publishedBy], references: [id])
  archiver  User? @relation("archivedBy", fields: [archivedBy], references: [id])

  @@index([status])
  @@index([createdBy])
  @@map("content_items")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  contentItemId String @map("content_item_id") @db.Uuid

  actorId String      @map("actor_id") @db.Uuid
  action  AuditAction

  changes Json?
  at      DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id])

  @@index([contentItemId, at])
  @@map("audit_log")
}
